# Copia este archivo a ".env.prod" en el VPS y completa los valores reales.
# ".env.prod" NUNCA debe subirse a git (ya está en .gitignore) — contiene contraseñas y
# llaves reales una vez completado.
#
# Uso: docker compose -f docker-compose.prod.yml --env-file .env.prod up -d --build

# ---------- Dominio ----------
# El dominio (o subdominio) que ya apunta por DNS (registro A) a la IP de este VPS.
# Caddy emite el certificado HTTPS para este nombre exacto la primera vez que arranca.
DOMAIN=tudominio.com

# ---------- Base de datos ----------
DB_NAME=sie_juridicos
DB_USER=sie_user
# Genera una contraseña real y larga, por ejemplo con: openssl rand -base64 24
DB_PASSWORD=cambia-esto-por-una-contrasena-real

# ---------- JWT ----------
# Mínimo 256 bits. Genera una con: openssl rand -base64 48
JWT_SECRET=cambia-esto-por-un-secreto-largo-y-aleatorio

# ---------- Primer administrador (se crea solo al arrancar si no existe, ver
# AdminBootstrapRunner) ----------
ADMIN_BOOTSTRAP_EMAIL=admin@tudominio.com
ADMIN_BOOTSTRAP_PASSWORD=cambia-esto-por-una-contrasena-real

# ---------- Correo saliente (SMTP) ----------
# Para Gmail: activa verificación en 2 pasos y genera una "contraseña de aplicación" en
# https://myaccount.google.com/apppasswords (no uses la contraseña normal de la cuenta).
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=siejuridicos@gmail.com
MAIL_ADMIN=siejuridicos@gmail.com

# ---------- Chatbot (Spring AI / Anthropic) ----------
ANTHROPIC_API_KEY=

# ---------- Otros ----------
FIRMA_WHATSAPP_URL=

# ---------- Límites de memoria por contenedor (opcional, valores por defecto ya
# sensatos para un VPS de 1-2 GB de RAM total; ajusta solo si tu VPS es más grande o
# más pequeño) ----------
# POSTGRES_MEM_LIMIT=384m
# BACKEND_MEM_LIMIT=512m
# FRONTEND_MEM_LIMIT=256m
# CADDY_MEM_LIMIT=128m
