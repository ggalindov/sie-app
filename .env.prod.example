# Copia este archivo a ".env.prod" en el VPS y completa los valores reales.
# ".env.prod" NUNCA debe subirse a git (ya está en .gitignore) — contiene contraseñas y
# llaves reales una vez completado.
#
# Uso: docker compose -f docker-compose.prod.yml --env-file .env.prod up -d --build

# ---------- Dominio ----------
# El dominio (o subdominio) que ya apunta por DNS (registro A) a la IP de este VPS.
# Caddy emite el certificado HTTPS para este nombre exacto la primera vez que arranca.
DOMAIN=tudominio.com

# ---------- Base de datos ----------
DB_NAME=sie_juridicos
DB_USER=sie_user
# Genera una contraseña real y larga, por ejemplo con: openssl rand -base64 24
DB_PASSWORD=cambia-esto-por-una-contrasena-real

# ---------- JWT ----------
# Mínimo 256 bits. Genera una con: openssl rand -base64 48
JWT_SECRET=cambia-esto-por-un-secreto-largo-y-aleatorio

# ---------- Primer administrador (se crea solo al arrancar si no existe, ver
# AdminBootstrapRunner) ----------
ADMIN_BOOTSTRAP_EMAIL=admin@tudominio.com
ADMIN_BOOTSTRAP_PASSWORD=cambia-esto-por-una-contrasena-real

# ---------- Correo saliente (SMTP) ----------
# Para Gmail: activa verificación en 2 pasos y genera una "contraseña de aplicación" en
# https://myaccount.google.com/apppasswords (no uses la contraseña normal de la cuenta).
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=siejuridicos@gmail.com
MAIL_ADMIN=siejuridicos@gmail.com

# ---------- Chatbot (Spring AI / Anthropic) ----------
ANTHROPIC_API_KEY=

# ---------- Otros ----------
FIRMA_WHATSAPP_URL=

# ---------- Google Sheets de casos (consulta de estado en /consulta-caso, solo lectura,
# ver HojaCalculoService) ----------
# El ID de la hoja (el segmento largo en su URL, entre /d/ y /edit).
GOOGLE_SHEETS_ID=
# La llave JSON de la cuenta de servicio de Google Cloud NO va aquí (ver DEPLOY.md):
# docker-compose.prod.yml la monta como secreto de Docker Compose desde
# ./secrets/google-sheets-service-account.json, nunca como variable de entorno.

# ---------- Cifrado de datos sensibles de clientes/casos (ver CifradoService) ----------
# 32 bytes en Base64. Genera una real con: openssl rand -base64 32
# NUNCA reutilices el valor de desarrollo (ver application.properties) en producción, y
# nunca la pierdas/cambies después de tener datos reales guardados: sin esta llave exacta,
# esos datos quedan permanentemente indescifrables (no hay forma de "recuperar" un cifrado
# AES sin su llave -- por diseño).
DATA_ENCRYPTION_KEY=

# ---------- WhatsApp de la línea de atención (notificación del radicado, ver
# WhatsAppService) ----------
# Cuenta de servicio de la API oficial de Meta (WhatsApp Cloud API), NO la app normal de
# WhatsApp Business. Ver DEPLOY.md sección 2.2 para la guía completa (verificar el número,
# generar un token permanente, redactar y aprobar la plantilla de mensaje).
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Debe coincidir EXACTO con el nombre de una plantilla ya aprobada por Meta.
WHATSAPP_TEMPLATE_NAME=notificacion_radicado

# ---------- Cobros Pendientes (recordatorio mensual de pago por correo y WhatsApp, ver
# módulo cobro/) ----------
# Google Sheets DISTINTO al de casos, misma cuenta de servicio (mismo archivo JSON de
# arriba) pero compartida con permiso de EDITOR sobre ESTA hoja específica -- es la única
# escritura real que hace el sistema (marcar la columna "RESPONDIO MENSAJE"). Ver DEPLOY.md.
GOOGLE_SHEETS_COBROS_ID=
# Plantilla de WhatsApp DISTINTA a la de radicado, con botones de respuesta rápida Sí/No,
# aprobada aparte en Meta.
WHATSAPP_TEMPLATE_COBRO_NAME=recordatorio_cobro
# Verifican el webhook público que recibe la respuesta del cliente (ver
# WhatsAppWebhookController). WHATSAPP_WEBHOOK_VERIFY_TOKEN la inventas tú mismo (una cadena
# aleatoria) y la registras igual en Meta al configurar el webhook; WHATSAPP_APP_SECRET sale
# de Meta Business Manager (Configuración básica de la app).
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=

# Aviso interno (no al cliente): apenas llega una solicitud nueva del formulario público, se
# manda un WhatsApp con el resumen completo a la línea interna de la firma. Plantilla
# DISTINTA a las de radicado/cobro, debe aprobarse aparte en Meta. El número ya trae el fijo
# pedido por la firma (+57 312 4781583); cámbialo solo si piden otra línea.
WHATSAPP_TEMPLATE_SOLICITUD_NAME=nueva_solicitud
WHATSAPP_ADMIN_NUMERO=+573124781583

# ---------- Límites de memoria por contenedor (opcional, valores por defecto ya
# sensatos para un VPS de 1-2 GB de RAM total; ajusta solo si tu VPS es más grande o
# más pequeño) ----------
# POSTGRES_MEM_LIMIT=384m
# BACKEND_MEM_LIMIT=1024m
# FRONTEND_MEM_LIMIT=256m
# CADDY_MEM_LIMIT=128m
